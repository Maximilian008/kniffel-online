{
  "name": "kniffel-online",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,web -c yellow,cyan \"pnpm dev:server\" \"pnpm dev:web\"",
    "dev:server": "node scripts/ensure-web-dist.mjs && wrangler dev --port 8787",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "preview": "pnpm build && wrangler dev --port 8787",
    "release": "pnpm build && wrangler deploy",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wrangler": "^4.140.0"
  },
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": ">=20"
  }
}
