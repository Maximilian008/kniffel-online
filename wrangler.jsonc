// Cloudflare deployment: one Worker serves the website and the game server.
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kniffel-online",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    // Built website (pnpm build). Served directly; only /api/* runs the Worker.
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "KniffelRoom" }]
  },
  // SQLite-backed Durable Objects are included in the Workers Free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KniffelRoom"] }],
  "observability": { "enabled": true }
}
